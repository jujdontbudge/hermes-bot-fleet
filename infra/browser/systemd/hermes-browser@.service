[Unit]
Description=Hermes isolated headed browser and takeover gate for %i
After=network-online.target tailscaled.service
Wants=network-online.target


[Service]
Type=simple
User=bot-%i
Group=bot-%i
WorkingDirectory=/
ExecStart=/usr/local/libexec/hermes-browser-supervisor daemon --bot %i
ExecStop=/usr/local/libexec/hermes-browser-supervisor stop --bot %i
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=60
# Rootless Podman needs the host newuidmap/newgidmap setuid helpers. Chromium
# remains inside the Bot's rootless user namespace and uses the pinned seccomp profile.
# Podman/slirp4netns must create its rootless network namespace in the host /tmp;
# container tmpfs mounts and Bot Unix identities provide the isolation boundary.
# Rootless Podman requires writable per-user CNI and storage paths; host DAC and
# the distinct bot Unix identity protect system and cross-Bot paths.
# Host capability bounds are not emptied because newuidmap/newgidmap must gain their
# narrowly scoped setuid privilege; the host service still runs as the Bot Unix user.
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=hermes-browser@%i.target

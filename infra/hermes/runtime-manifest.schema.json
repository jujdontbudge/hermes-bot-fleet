{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.invalid/schema/hermes-runtime-manifest-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hermes_version", "runtime_image", "runtime_image_digest", "runtime_image_revision", "model", "provider", "bots"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "hermes_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][A-Za-z0-9.-]+)?$"},
    "runtime_image": {"type": "string", "pattern": "^[A-Za-z0-9._/:~-]+@sha256:[a-f0-9]{64}$"},
    "runtime_image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "runtime_image_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "model": {"const": "gpt-5.6-sol"},
    "provider": {"const": "openai-codex"},
    "bots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chief", "test-worker"],
      "properties": {
        "chief": {"$ref": "#/$defs/bot"},
        "test-worker": {"$ref": "#/$defs/bot"}
      }
    }
  },
  "$defs": {
    "bot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unix_user", "serve_port", "workspace"],
      "properties": {
        "unix_user": {"type": "string", "pattern": "^bot-(chief|test-worker)$"},
        "serve_port": {"enum": [8701, 8702]},
        "workspace": {"type": "string", "pattern": "^/workspaces/(chief|test-worker)$"}
      }
    }
  }
}

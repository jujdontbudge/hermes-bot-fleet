[Unit]
Description=Hermes gateway and cron owner for %i
After=network-online.target tailscaled.service
Wants=network-online.target
Upholds=hermes-serve@%i.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bot-%i
Group=bot-%i
EnvironmentFile=/etc/hermes-fleet/%i/runtime.env
ExecStartPre=/usr/local/libexec/hermes-fleet-preflight %i gateway
ExecStart=/usr/local/libexec/hermes-fleet-run %i gateway
ExecStop=-/usr/bin/podman stop --time 30 hermes-%i-gateway
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=45
# Rootless Podman requires the newuidmap/newgidmap setuid helpers when its
# user namespace is recreated after boot. The container itself enforces
# no-new-privileges and has no host capabilities.
PrivateTmp=yes
UMask=0077
LimitNOFILE=65536
CPUQuota=80%
MemoryMax=3G
TasksMax=512

[Install]
WantedBy=hermes-runtime@%i.target
